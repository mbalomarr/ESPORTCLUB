<?xml version="1.0" encoding="utf-8"?>
<!--
  PMU E-Sports Club: IIS / ASP.NET settings for MonsterASP.

  ⚠ Connection string: the values below are PLACEHOLDERS. Put the real database details
  into this file ON THE SERVER ONLY (MonsterASP File Manager → wwwroot → web.config).
  Never save the real password in GitHub: the repository is public.
-->
<configuration>
  <connectionStrings>
    <add name="MonsterASP_DB_Connection"
         connectionString="Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="false" targetFramework="4.8">
      <assemblies>
        <!-- JSON support for register.ashx -->
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </assemblies>
    </compilation>
    <!-- Registrations are tiny; reject anything over 64 KB. -->
    <httpRuntime targetFramework="4.8" maxRequestLength="64" enableVersionHeader="false" />
    <!-- Never show technical error details to visitors. -->
    <customErrors mode="On" />
  </system.web>

  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="65536" />
        <!-- Block downloading setup/documentation files if they are ever uploaded by mistake. -->
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
